@echo off
rem Regenerates src\embedded\Fonts.hpp from res\fonts\*.ttf using Dear ImGui's binary_to_compressed_c.
setlocal
cd /d "%~dp0.."
if not exist build mkdir build
g++ -O2 -o build\b2c.exe tools\binary_to_compressed_c.cpp || exit /b 1
set OUT=src\embedded\Fonts.hpp
> %OUT% echo // Generated by tools/gen_fonts.bat (binary_to_compressed_c -u8). Do not edit.
>> %OUT% echo // Roboto-Medium + Cousine-Regular (Apache 2.0), Font Awesome 6 Free Solid (SIL OFL 1.1).
>> %OUT% echo #pragma once
build\b2c.exe -u8 res\fonts\Roboto-Medium.ttf Roboto >> %OUT%
build\b2c.exe -u8 res\fonts\Cousine-Regular.ttf Mono >> %OUT%
build\b2c.exe -u8 res\fonts\fa-solid-900.ttf FontAwesome >> %OUT%
echo Wrote %OUT%