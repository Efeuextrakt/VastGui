// VastGui resources: application icon, manifest (PerMonitorV2 DPI, UTF-8) and version info.
#include <winver.h>

#define VASTGUI_VERSION_BIN 1,3,0,0
#define VASTGUI_VERSION_STR "1.3.0.0"

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VASTGUI_VERSION_BIN
PRODUCTVERSION VASTGUI_VERSION_BIN
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VastGui contributors"
            VALUE "FileDescription", "VastGui - desktop client for vast.ai"
            VALUE "FileVersion", VASTGUI_VERSION_STR
            VALUE "InternalName", "VastGui"
            VALUE "LegalCopyright", "Copyright (c) 2026 Efeuextrakt. MIT License. Third-party: see THIRD_PARTY_LICENSES.txt"
            VALUE "OriginalFilename", "VastGui.exe"
            VALUE "ProductName", "VastGui"
            VALUE "ProductVersion", VASTGUI_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
